# Copy to .env and fill in. Consumed by lib/config.ts.
#
# Nothing loads this file automatically — the npm scripts do not pass
# --env-file, so either run Node with it yourself:
#   node --env-file=.env node_modules/tsx/dist/cli.mjs main.ts "<maps-url>"
# or export the variables in your shell before running npm run dev.
#
# Every value here is optional except the API key of the provider you select.
# Stages 1–3 (discovery, collection, normalization) need no credentials at all.

# --- Runtime ---
LOG_LEVEL=info
OUTPUT_DIR=./output

# --- Browser (collector / discovery) ---
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_LOCALE=en-US
# BROWSER_USER_AGENT=
# BROWSER_PROXY_URL=

# --- Collector (website crawl) ---
COLLECTOR_MAX_PAGES=6
COLLECTOR_MAX_IMAGES=40
COLLECTOR_MIN_ASSET_BYTES=1024
COLLECTOR_MAX_ASSET_BYTES=8000000
COLLECTOR_ASSET_DIR=assets

# ------------------------------------------------------------------
# AI provider
# ------------------------------------------------------------------
# Which vendor serves the LLM stages. One of: anthropic | openai | gemini | openrouter
# Defaults to anthropic when unset. Switching providers needs no code change and
# no agent change — only this line and the matching API key.
AI_PROVIDER=anthropic

# Only the selected provider's key is required; the others may stay empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Wall-clock budget for one provider request, in ms.
AI_REQUEST_TIMEOUT_MS=300000

# Retry for provider calls the adapter marked retryable (429, 5xx, transport).
# Added after two of five generations in one batch died on a transient 503.
# Exponential backoff with full jitter. 0 disables retries.
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY_MS=1000

# Endpoint overrides. Leave unset to use each adapter's default. This is the
# seam for an Azure deployment, a local Ollama, a gateway, or a proxy.
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# GEMINI_BASE_URL=
# OPENROUTER_BASE_URL=

# OpenRouter app attribution — optional, shown on your OpenRouter dashboard.
# OPENROUTER_REFERER=
# OPENROUTER_TITLE=

# ------------------------------------------------------------------
# Stages that use a model
# ------------------------------------------------------------------
# Model ids are provider-specific. Leave unset to use the selected provider's
# default: anthropic=claude-opus-5, openai=gpt-5, gemini=gemini-3.6-flash,
# openrouter=openai/gpt-5. On OpenRouter, set this explicitly — ids there are
# `vendor/model` slugs and the catalogue moves.

# --- Business analyst (stage 4) ---
# ANALYST_MODEL=
# low | medium | high | xhigh | max
ANALYST_EFFORT=high
# Caps thinking and response together — keep generous.
ANALYST_MAX_OUTPUT_TOKENS=32000
ANALYST_MAX_PAGE_CHARS=4000

# --- Writer (stage 5) ---
# WRITER_MODEL=
WRITER_EFFORT=high
# Caps thinking and response together — a whole site's copy plus the reasoning
# behind it. A truncated response fails the stage rather than shortening it.
WRITER_MAX_OUTPUT_TOKENS=24000
# Per-page cap on the site text excerpted into the writer's brief. The business's
# own words are the only source of anything specific enough to write from, so
# this is more generous than the analyst's.
WRITER_MAX_PAGE_CHARS=6000

# ------------------------------------------------------------------
# Platform: skills, MCP, telemetry, feature flags
# ------------------------------------------------------------------
# Comma-separated ids. SKILLS_ENABLED empty means "all registered skills";
# SKILLS_DISABLED is applied last and always wins.
# SKILLS_ENABLED=
# SKILLS_DISABLED=
# Extra directories scanned for *.skill.ts at startup (comma-separated).
# SKILLS_DIR=
# Per-skill-call budget in ms; 0 disables the timeout.
SKILL_TIMEOUT_MS=120000

# MCP servers, as a JSON array. `transport` is http (needs `endpoint`) or
# stdio (needs `command`; declared but not implemented — calls return
# not_implemented). Headers are sent verbatim: nothing expands ${VAR} here, so
# write the literal token. Example:
#   MCP_SERVERS=[{"id":"github","transport":"http","endpoint":"https://api.githubcopilot.com/mcp/","headers":{"Authorization":"Bearer ghp_xxx"},"requiredCredentials":["GITHUB_TOKEN"]}]
# A malformed entry fails startup rather than being skipped.
# MCP_SERVERS=
# MCP_ENABLED=
# MCP_DISABLED=
MCP_REQUEST_TIMEOUT_MS=60000

TELEMETRY_ENABLED=true
TELEMETRY_SAMPLE_LIMIT=100

# Terse form: FEATURE_FLAGS=places-api,!batch-mode  (a leading ! turns one off)
# Explicit form: FEATURE_<NAME>=true|false, which wins over the terse form.
# Names normalise to lower-case with hyphens, so FEATURE_PLACES_API and
# `places-api` are the same flag. Unknown flags are off.
# FEATURE_FLAGS=

# ------------------------------------------------------------------
# Skill and MCP credentials
# ------------------------------------------------------------------
# Skills and MCP servers declare the variables they need by name, and the
# platform reports a missing one as a `missing_credential` error naming it.
#
# Any variable ending in _API_KEY, _KEY, _TOKEN, _SECRET, _PASSWORD or
# _CREDENTIALS — plus DATABASE_URL — is picked up automatically, so a
# third-party skill can declare its own without changing lib/config.ts.
#
# The built-in placeholders declare these. None is required today: every
# built-in skill is unimplemented, so setting one changes a `missing_credential`
# error into a `not_implemented` one and nothing more.
# FIRECRAWL_API_KEY=
# GOOGLE_MAPS_API_KEY=
# SEARCH_API_KEY=
# GITHUB_TOKEN=
# DATABASE_URL=
# PAYMENTS_API_KEY=
# CMS_API_KEY=
# SOCIAL_API_KEY=
# EMAIL_API_KEY=
# CALENDAR_API_KEY=

# --- Lovable (deploy) ---
LOVABLE_API_KEY=
LOVABLE_BASE_URL=https://api.lovable.dev
# LOVABLE_PROJECT_ID=
LOVABLE_DEPLOY_TIMEOUT_MS=300000

