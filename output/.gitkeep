#   output/<runId>/2-collected.json
#   output/<runId>/3-content.json
#   output/<runId>/4-deployment.json
#   output/<runId>/result.json
#   output/<runId>/run.log.ndjson
#
# Contents are gitignored; this file keeps the folder tracked.
