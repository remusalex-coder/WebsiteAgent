{
  "name": "website-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous AI website builder: Google Maps URL in, deployed website out.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx main.ts",
    "discover": "tsx main.ts --discovery-only",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
