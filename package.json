{
  "name": "website-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous AI website builder: Google Maps URL in, deployed website out.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "start": "node dist/main.js",
    "dev": "tsx main.ts",
    "discover": "tsx main.ts --discovery-only",
    "render": "tsx main.ts --render",
    "resume": "tsx main.ts",
    "awwwards": "node --import tsx --env-file=.env.awwwards main.ts",
    "design-director": "node --import tsx --env-file=.env scripts/design-director-smoke.ts",
    "experience-intent": "node --import tsx --env-file=.env scripts/experience-intent-smoke.ts",
    "build-site": "node --import tsx --env-file=.env main.ts",
    "publish": "node --import tsx scripts/publish-run.ts",
    "visual-qa": "node --import tsx scripts/visual-qa.ts",
    "ab": "node --import tsx scripts/ab-floor-vs-director.ts",
    "probe-providers": "node --import tsx --env-file=.env scripts/probe-providers.ts",
    "probe-openrouter-free": "node --import tsx --env-file=.env scripts/probe-openrouter-free.ts",
    "forge": "node --import tsx --env-file=.env scripts/forge/run.ts",
    "capability-board": "node --import tsx --env-file=.env scripts/capability-board.ts",
    "capability-proof": "node --import tsx --env-file=.env scripts/capability-e2e-proof.ts",
    "preview": "node scripts/preview.mjs",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
